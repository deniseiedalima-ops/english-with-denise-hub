{
  "functions": {
    "api/notion.js": {
      "maxDuration": 60
    },
    "api/summarize.js": {
      "maxDuration": 60
    },
    "api/site.js": {
      "maxDuration": 30
    },
    "api/birthday.js": {
      "maxDuration": 60
    },
    "api/feedback.js": {
      "maxDuration": 60
    },
    "api/report.js": {
      "maxDuration": 30
    }
  },
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}